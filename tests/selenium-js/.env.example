# Test Environment Configuration
BASE_URL=http://localhost:3000
API_URL=http://localhost:8080

# Test User Credentials (REQUIRED for tests to work)
# Email login with OTP
TEST_EMAIL=your_test_email@example.com
# OTP is optional - if not provided, you'll need to enter it manually during test
TEST_OTP=

# Browser Settings
BROWSER=chrome
HEADLESS=false
IMPLICIT_WAIT=10000
EXPLICIT_WAIT=20000

# Screenshot Settings
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_PATH=./screenshots

# Test Data
NUMBER_OF_OFFERS=500
